import math;

// [TEST 2] Record Definitions
// Rules: RECORD ID LBRACE decl_list RBRACE
record NeuralConfig {
    float32 scalar learning_rate;
    int32 scalar max_epochs;
    bool scalar is_active;
}

// [TEST 3] Function Declaration
// Rules: FUNC ID ... ARROW dtype shape_type block 
// CompOp, Block, argList, paramList
func relu_activation(float32 scalar val, float32 scalar x) -> float32 scalar {
    if (val > 0.0 && val < 100.0) {
        return val;
    } else {
        return 0.0;
    }
}

// [TEST 5] Linear Algebra
// Rules: matrix < num, num > and vector < num >
// Shape Type, Matrix
float32 matrix<3,3> Weights = [
    [0.5, -0.2, 0.1],
    [0.9,  0.0, -0.3],
    [0.2,  0.1,  0.4]
];

float32 matrix<3,3> weights_2 = [
    [0.2, -0.5, 0.2],
    [0.3,  0.6, -0.4],
    [0.4,  0.7,  0.3]
];

probe(Weights);

probe(Weights @ weights_2);

float32 matrix<3,1> dim1 = [
	[0.5, -0.2, 0.1]
];

float32 matrix<1,3> dim2 = [
	[0.5],
	[0.2],
	[0.7]
];

probe(dim2 @ dim1);
