// --- Quantel Heap & Pointer Test ---

print("1. Testing Variable vs Pointer");
float32 scalar total_activation = 0.85;
float32 scalar *ptr = malloc(total_activation); 

probe(total_activation); // Should show value on stack
probe(ptr);              // Should show heap address (e.g., @00)

print("2. Testing Address-Of Operator");
int32 scalar count = 100;
int32 scalar *count_ptr = &count;

probe(count_ptr); // Should show the reference to the stack variable

print("3. Testing Heap Reuse");
float32 scalar *p1 = malloc(1.1);
float32 scalar *p2 = malloc(2.2);
show_heap(); // Shows @01 and @02 allocated

print("Freeing @01...");
free(p1);
show_heap(); // @01 should be [ FREE ]

print("Re-allocating (should reuse @01)...");
float32 scalar *p3 = malloc(3.3);
show_heap(); 

print("--- Test Complete ---");
