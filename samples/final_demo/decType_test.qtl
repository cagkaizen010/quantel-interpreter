// Quantel Final Demonstration

// --- 1. Declarations and Types Demo ---
print("--- 1. Valid Declarations ---");

// Primitives
int32 scalar num = 42;
float32 scalar pi = 3.1415;
bool scalar is_active = true;

// Arrays (leveraging your NumPy backend)
int32 matrix<1,3> vector_a = [1, 2, 3];
int32 matrix<1,3> vector_b = [4, 5, 6];

// Pointer evaluation (using the & unary operator from visit_UnaryOp)
int32 scalar *ptr = &num; 

print(num);
print(pi);
print(is_active);

// Using probe
probe(vector_a);
print(ptr);





